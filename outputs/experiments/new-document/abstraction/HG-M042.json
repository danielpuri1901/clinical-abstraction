 "observations": [
  {
   "observed_on": "2026-01-05",
   "category": "anxiety",
   "text": "Anxiety about resuming work responsibilities.",
   "sources": [
    "BH-D003 L10"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "avoidance",
   "text": "Postponing email replies and avoiding conversations about the return to work.",
   "sources": [
    "BH-D002 L11"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "avoidance",
   "text": "Avoidance of tasks and communication.",
   "sources": [
    "BH-D003 L10"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "mood",
   "text": "Several weeks of low mood and reduced interest in usual activities.",
   "sources": [
    "BH-D002 L11"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "mood",
   "text": "Presenting needs include depressed mood.",
   "sources": [
    "BH-D003 L10"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "safety",
   "text": "No immediate safety concern was identified.",
   "sources": [
    "BH-D002 L13"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "sleep",
   "text": "Fragmented sleep, waking in the night and checking the time repeatedly.",
   "sources": [
    "BH-D002 L11",
    "BH-D002 L13"
   ]
  },
  {
   "observed_on": "2026-01-05",
   "category": "sleep",
   "text": "Sleep disruption is a presenting need.",
   "sources": [
    "BH-D003 L10"
   ]
  },
  {
   "observed_on": "2026-01-06",
   "category": "avoidance",
   "text": "Rowan delayed replying to a work message because of fear of being asked for a firm return date.",
   "sources": [
    "BH-D004 L14"
   ]
  },
  {
   "observed_on": "2026-01-06",
   "category": "functioning",
   "text": "Rowan practiced breathing, chose reading the message before responding, and seemed receptive to peers.",
   "sources": [
    "BH-D004 L14"
   ]
  },
  {
   "observed_on": "2026-01-06",
   "category": "reason_for_contact",
   "text": "Rowan arrived late after parking difficulty and left early for a previously arranged ride.",
   "sources": [
    "BH-D005 L13"
   ]
  },
  {
   "observed_on": "2026-01-08",
   "category": "reason_for_contact",
   "text": "Patient did not check in or cancel for the 11:00 individual visit and was marked no show.",
   "sources": [
    "BH-D015 L9",
    "BH-D015 L11"
   ]
  },
  {
   "observed_on": "2026-01-08",
   "category": "sleep",
   "text": "Patient reported a poor night of sleep and the morning getting away from them.",
   "sources": [
    "BH-D015 L15"
   ]
  },
  {
   "observed_on": "2026-01-09",
   "category": "functioning",
   "text": "Rowan felt watched when repeatedly asked whether they had contacted work.",
   "sources": [
    "BH-D007 L12"
   ]
  },
  {
   "observed_on": "2026-01-09",
   "category": "functioning",
   "text": "Rowan described partner reminders as evidence of falling behind; Casey said reminders were meant to help but increased tension.",
   "sources": [
    "BH-D008 L11"
   ]
  },
  {
   "observed_on": "2026-01-09",
   "category": "functioning",
   "text": "Rowan wants to keep ownership of the return-to-work process; the rehearsal became less defensive with repetition.",
   "sources": [
    "BH-D008 L13"
   ]
  },
  {
   "observed_on": "2026-01-09",
   "category": "mood",
   "text": "Rowan became more animated describing a shared evening walk, seen as support without pressure.",
   "sources": [
    "BH-D007 L16"
   ]
  },
  {
   "observed_on": "2026-01-09",
   "category": "reason_for_contact",
   "text": "Visit focused on patterns of support at home as Rowan tries to rebuild a routine.",
   "sources": [
    "BH-D007 L12"
   ]
  },
  {
   "observed_on": "2026-01-09",
   "category": "reason_for_contact",
   "text": "Family appointment focused on communication practice to slow down an anxious exchange.",
   "sources": [
    "BH-D008 L11"
   ]
  },
  {
   "observed_on": "2026-01-12",
   "category": "anxiety",
   "text": "Rowan said a walk with Casey over the weekend helped the evening feel less dominated by worry.",
   "sources": [
    "BH-D009 L14"
   ]
  },
  {
   "observed_on": "2026-01-12",
   "category": "avoidance",
   "text": "Rowan described leaving work messages unopened and named looking at one message as a smaller step.",
   "sources": [
    "BH-D009 L14"
   ]
  },
  {
   "observed_on": "2026-01-13",
   "category": "mood",
   "text": "Mood was somewhat less heavy on days with a planned activity, with ongoing concern about work communication.",
   "sources": [
    "BH-D010 L11"
   ]
  },
  {
   "observed_on": "2026-01-13",
   "category": "reason_for_contact",
   "text": "Visit was for medication management and review of adherence, tolerability and symptom response.",
   "sources": [
    "BH-D010 L11"
   ]
  },
  {
   "observed_on": "2026-01-13",
   "category": "sleep",
   "text": "Rowan reported continuing sleep interruption and daytime tiredness.",
   "sources": [
    "BH-D010 L11"
   ]
  },
  {
   "observed_on": "2026-01-14",
   "category": "avoidance",
   "text": "Rowan has not replied to a work message and imagines being asked questions they cannot answer.",
   "sources": [
    "BH-D011 L11"
   ]
  },
  {
   "observed_on": "2026-01-14",
   "category": "functioning",
   "text": "Rowan completed small activities, including two short walks, since the prior appointment.",
   "sources": [
    "BH-D011 L11"
   ]
  },
  {
   "observed_on": "2026-01-14",
   "category": "mood",
   "text": "Affect was more varied than at intake, though worry was evident when discussing employment.",
   "sources": [
    "BH-D011 L15"
   ]
  },
  {
   "observed_on": "2026-01-14",
   "category": "sleep",
   "text": "Sleep remains interrupted and getting started in the morning takes effort.",
   "sources": [
    "BH-D011 L11"
   ]
  },
  {
   "observed_on": "2026-01-15",
   "category": "reason_for_contact",
   "text": "The clinic cancelled the coping skills group because of staff illness.",
   "sources": [
    "BH-D016 L9"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "avoidance",
   "text": "Getting out of the apartment is a little easier, but thinking about work still makes Rowan want to put things off.",
   "sources": [
    "BH-D013 L11"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "avoidance",
   "text": "Ongoing avoidance of work communication.",
   "sources": [
    "BH-D014 L15"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "functioning",
   "text": "Partner reported Rowan had been getting out for short walks and seemed more willing to discuss the coming week.",
   "sources": [
    "BH-D012 L13"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "functioning",
   "text": "Rowan has tried small activities and communication practice but has no reliable routine yet.",
   "sources": [
    "BH-D013 L13"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "mood",
   "text": "Partner said mornings remain difficult and Rowan becomes quiet when conversation turns to work.",
   "sources": [
    "BH-D012 L13"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "mood",
   "text": "Clinician sees some improvement in depressive symptoms; PHQ-9 fell from 18 to 14.",
   "sources": [
    "BH-D013 L11",
    "BH-D013 L13"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "mood",
   "text": "Some improvement in depressive symptoms.",
   "sources": [
    "BH-D014 L15"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "reason_for_contact",
   "text": "Partner attended the arranged contact after Rowan said they could not participate.",
   "sources": [
    "BH-D012 L11"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "sleep",
   "text": "Rowan described sleep as inconsistent.",
   "sources": [
    "BH-D013 L11"
   ]
  },
  {
   "observed_on": "2026-01-16",
   "category": "sleep",
   "text": "Sleep is inconsistent.",
   "sources": [
    "BH-D014 L15"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "anxiety",
   "text": "Rowan became visibly tense when discussion turned to returning to the workplace and said the amount of discussion felt difficult to manage.",
   "sources": [
    "BH-D101 L10"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "anxiety",
   "text": "Patient identified anxiety about reconnecting with work.",
   "sources": [
    "BH-D102 L14"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "anxiety",
   "text": "Patient felt overwhelmed hearing about workplace demands and noted muscle tension, rapid breathing, and an urge to leave; anxiety eased with breathing.",
   "sources": [
    "BH-D105 L9",
    "BH-D105 L11"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "avoidance",
   "text": "Rowan identified postponing a message to a supervisor as a familiar pattern.",
   "sources": [
    "BH-D101 L10"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "avoidance",
   "text": "Persistent avoidance and disrupted sleep continue to interfere with resuming usual work routine.",
   "sources": [
    "BH-D105 L13"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "reason_for_contact",
   "text": "Patient requested additional help and staff arranged access to the individual clinician.",
   "sources": [
    "BH-D102 L14"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "reason_for_contact",
   "text": "Patient attended the opening check-in, accepted the handout, and requested additional help from the individual clinician.",
   "sources": [
    "BH-D104 L18"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "reason_for_contact",
   "text": "Visit added because the patient became anxious during group and needed individual grounding.",
   "sources": [
    "BH-D105 L9"
   ]
  },
  {
   "observed_on": "2026-01-19",
   "category": "safety",
   "text": "Patient denied current suicidal thoughts; no acute safety concern identified.",
   "sources": [
    "BH-D105 L13"
   ]
  },
  {
   "observed_on": "2026-01-21",
   "category": "avoidance",
   "text": "Patient drafted a message about returning to work but stopped before sending it and repeatedly checked the draft.",
   "sources": [
    "BH-D106 L9"
   ]
  },
  {
   "observed_on": "2026-01-21",
   "category": "safety",
   "text": "No urgent safety concern was reported.",
   "sources": [
    "BH-D106 L11"
   ]
  },
  {
   "observed_on": "2026-01-21",
   "category": "sleep",
   "text": "One night of improved sleep was followed by a night of prolonged wakefulness.",
   "sources": [
    "BH-D106 L11"
   ]
  },
  {
   "observed_on": "2026-01-22",
   "category": "anxiety",
   "text": "Rowan worried that seeing outstanding items on the work calendar would become overwhelming.",
   "sources": [
    "BH-D107 L9"
   ]
  },
  {
   "observed_on": "2026-01-23",
   "category": "avoidance",
   "text": "Clinician will keep addressing avoidance and coping in scheduled therapy.",
   "sources": [
    "BH-D109 L11"
   ]
  },
  {
   "observed_on": "2026-01-23",
   "category": "reason_for_contact",
   "text": "Outside social worker and clinician coordinated practical supports for the patient's return to work.",
   "sources": [
    "BH-D109 L9"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "anxiety",
   "text": "Worry about being asked for commitments the patient might not meet; kept postponing choosing a time for the conversation.",
   "sources": [
    "BH-D110 L9"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "anxiety",
   "text": "Patient anticipated becoming overwhelmed if several work issues were raised at once.",
   "sources": [
    "BH-D111 L10"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "avoidance",
   "text": "Patient was hesitant about completing the task outside the office; work continues on avoidance.",
   "sources": [
    "BH-D110 L13"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "mood",
   "text": "Presentation consistent with ongoing anxiety, low mood, and functional difficulty around work demands.",
   "sources": [
    "BH-D111 L14"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "safety",
   "text": "No current suicidal ideation was reported.",
   "sources": [
    "BH-D110 L13"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "sleep",
   "text": "Sleep remained uneven, with difficulty settling when work thoughts became repetitive.",
   "sources": [
    "BH-D110 L9"
   ]
  },
  {
   "observed_on": "2026-01-26",
   "category": "sleep",
   "text": "Repetitive planning at night affected settling for sleep.",
   "sources": [
    "BH-D111 L12"
   ]
  },
  {
   "observed_on": "2026-01-28",
   "category": "reason_for_contact",
   "text": "Patient cancelled the appointment due to a personal scheduling conflict.",
   "sources": [
    "BH-D108 L18"
   ]
  },
  {
   "observed_on": "2026-01-29",
   "category": "avoidance",
   "text": "Rowan opened the work calendar but delayed a follow-up conversation.",
   "sources": [
    "BH-D107 L14"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "anxiety",
   "text": "Rowan remained anxious about the work conversation but could explain the intended first step.",
   "sources": [
    "BH-D113 L13"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "anxiety",
   "text": "Anxiety remained noticeable when anticipating contact with work.",
   "sources": [
    "BH-D114 L8"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "avoidance",
   "text": "Reminders about contacting work led to long discussion and Rowan withdrawing from the task.",
   "sources": [
    "BH-D113 L11"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "avoidance",
   "text": "Persistent avoidance with delayed follow-up; anxious when a task expands beyond a narrow action.",
   "sources": [
    "BH-D115 L10"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "functioning",
   "text": "Patient reported a limited plan felt more manageable.",
   "sources": [
    "BH-D113 L13"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "functioning",
   "text": "Meaningful functional impact around returning to work, with partial improvement.",
   "sources": [
    "BH-D115 L10",
    "BH-D115 L12"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "mood",
   "text": "Mood felt less persistently low than earlier in the month.",
   "sources": [
    "BH-D114 L8"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "mood",
   "text": "Fewer days of pervasive low mood than at intake.",
   "sources": [
    "BH-D115 L8"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "reason_for_contact",
   "text": "Partner was unsure when reminders helped versus increased Rowan's sense of pressure.",
   "sources": [
    "BH-D113 L9"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "safety",
   "text": "Patient denied current suicidal thoughts; no new acute safety issue.",
   "sources": [
    "BH-D114 L10"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "sleep",
   "text": "Sleep was still variable.",
   "sources": [
    "BH-D114 L8"
   ]
  },
  {
   "observed_on": "2026-01-30",
   "category": "sleep",
   "text": "Sleep disruption remains an intermittent barrier to a steadier daytime routine.",
   "sources": [
    "BH-D115 L8",
    "BH-D115 L10"
   ]
  }
